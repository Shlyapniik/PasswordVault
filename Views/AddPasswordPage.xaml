<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="PasswordVault.Views.AddPasswordPage"
    Title="Новый пароль">

    <ScrollView>
        <VerticalStackLayout
            Padding="20"
            Spacing="15">

            <Label
                Text="Новый пароль"
                FontSize="28"
                FontAttributes="Bold" />

            <Entry
                Placeholder="Название"
                Text="{Binding Title}"/>

            <Entry
                Placeholder="Логин"
                Text="{Binding Username}"/>

            <Grid ColumnDefinitions="*, Auto">

                <Entry
                    Placeholder="Пароль"
                    IsPassword="True"
                    Text="{Binding Password}"/>
                
                <Button
                    Grid.Column="1"
                    Text="Сгенерировать"
                    Command="{Binding GeneratePasswordCommand}"
                    Margin="10,0,0,0" />
            </Grid>

            <Label
                Text="Настройка генератора"
                FontAttributes="Bold"
                FontSize="18" />

            <HorizontalStackLayout Spacing="10">

                <Label
                    Text="{Binding PasswordLength, StringFormat='Длина: {0:F0}'}"
                    VerticalOptions="Center" />

                <Stepper
                    Minimum="8"
                    Maximum="32"
                    Increment="1"
                    Value="{Binding PasswordLength}" />
            </HorizontalStackLayout>

            <HorizontalStackLayout Spacing="10">
                <CheckBox
                    x:Name="UseLowercaseCheckBox"
                    IsChecked="True" />
                <Label
                    Text="Строчные буквы"
                    VerticalOptions="Center" />
            </HorizontalStackLayout>

            <HorizontalStackLayout Spacing="10">
                <CheckBox
                    x:Name="UseUppercaseCheckBox"
                    IsChecked="True" />
                <Label
                    Text="Заглавные буквы"
                    VerticalOptions="Center" />         
            </HorizontalStackLayout>

            <HorizontalStackLayout Spacing="10">
                <CheckBox
                    x:Name="UseDigitsCheckBox"
                    IsChecked="True" />
                <Label
                    Text="Цифры"
                    VerticalOptions="Center" />
            </HorizontalStackLayout>

            <HorizontalStackLayout Spacing="10">
                <CheckBox
                    x:Name="UseSymbolsCheckBox"
                    IsChecked="True" />
                <Label
                    Text="Спецсимволы"
                    VerticalOptions="Center" />
            </HorizontalStackLayout>

            <Entry
                Placeholder="Веб-сайт"
                Text="{Binding Website}"/>

            <Editor
                Placeholder="Заметки"
                AutoSize="TextChanges"
                MinimumHeightRequest="120"
                Text="{Binding Notes}"/>

            <Button
                Text="Сохранить"
                Command="{Binding SaveCommand}"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>