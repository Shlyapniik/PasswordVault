<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="PasswordVault.Views.AddPasswordPage"
    Title="Новый пароль">

    <ScrollView>
        <VerticalStackLayout
            Padding="20"
            Spacing="15">

            <Label
                Text="Новый пароль"
                FontSize="28"
                FontAttributes="Bold" />

            <Entry
                x:Name="TitleEntry"
                Placeholder="Название" />

            <Entry
                x:Name="UsernameEntry"
                Placeholder="Логин" />

            <Entry
                x:Name="PasswordEntry"
                Placeholder="Пароль"
                IsPassword="True" />

            <Entry
                x:Name="WebsiteEntry"
                Placeholder="Веб-сайт" />

            <Editor
                x:Name="NotesEditor"
                Placeholder="Заметка"
                AutoSize="TextChanges"
                MinimumHeightRequest="120" />

            <Button
                Text="Сохранить"
                Clicked="OnSaveClicked" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>