<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="PasswordVault.Views.AddPasswordPage"
    Title="Новый пароль">

    <ScrollView>
        <VerticalStackLayout
            Padding="20"
            Spacing="15">

            <Label
                Text="Новый пароль"
                FontSize="28"
                FontAttributes="Bold" />

            <Entry
                x:Name="TitleEntry"
                Placeholder="Название" />

            <Entry
                x:Name="UsernameEntry"
                Placeholder="Логин" />

            <Grid ColumnDefinitions="*, Auto">

                <Entry
                    x:Name="PasswordEntry"
                    Placeholder="Пароль"
                    IsPassword="True" />
                
                <Button
                    Grid.Column="1"
                    Text="Сгенерировать"
                    Clicked="OnGeneratePasswordClicked"
                    Margin="10,0,0,0" />
            </Grid>

            <Label
                Text="Настройка генератора"
                FontAttributes="Bold"
                FontSize="18" />

            <HorizontalStackLayout Spacing="10">

                <Label
                    Text="Длина:"
                    VerticalOptions="Center" />

                <Stepper
                    x:Name="PasswordLengthStepper"
                    Minimum="4"
                    Maximum="64"
                    Increment="1"
                    Value="16" 
                    ValueChanged="OnPasswordLengthChanged" />

                <Label
                    x:Name="PasswordLengthLabel"
                    Text="16"
                    VerticalOptions="Center" />
            </HorizontalStackLayout>

            <HorizontalStackLayout Spacing="10">
                <CheckBox
                    x:Name="UseLowercaseCheckBox"
                    IsChecked="True" />
                <Label
                    Text="Строчные буквы"
                    VerticalOptions="Center" />
            </HorizontalStackLayout>

            <HorizontalStackLayout Spacing="10">
                <CheckBox
                    x:Name="UseUppercaseCheckBox"
                    IsChecked="True" />
                <Label
                    Text="Заглавные буквы"
                    VerticalOptions="Center" />         
            </HorizontalStackLayout>

            <HorizontalStackLayout Spacing="10">
                <CheckBox
                    x:Name="UseDigitsCheckBox"
                    IsChecked="True" />
                <Label
                    Text="Цифры"
                    VerticalOptions="Center" />
            </HorizontalStackLayout>

            <HorizontalStackLayout Spacing="10">
                <CheckBox
                    x:Name="UseSymbolsCheckBox"
                    IsChecked="True" />
                <Label
                    Text="Спецсимволы"
                    VerticalOptions="Center" />
            </HorizontalStackLayout>

            <Entry
                x:Name="WebsiteEntry"
                Placeholder="Веб-сайт" />

            <Editor
                x:Name="NotesEditor"
                Placeholder="Заметка"
                AutoSize="TextChanges"
                MinimumHeightRequest="120" />

            <Button
                Text="Сохранить"
                Clicked="OnSaveClicked" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>