<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="PasswordVault.Views.EditPasswordPage"
    Title="Редактирование">

    <ScrollView>
        <VerticalStackLayout
            Padding="20"
            Spacing="18">

            <!-- Заголовок -->
            <VerticalStackLayout
                Spacing="4">

                <Label
                    Text="Редактирование"
                    FontSize="28"
                    FontAttributes="Bold" />

                <Label
                    Text="Измените данные сохранённой записи"
                    FontSize="14"
                    TextColor="{StaticResource Gray500}" />

            </VerticalStackLayout>


            <!-- Основные данные -->
            <Border
                Padding="18"
                Stroke="{StaticResource Gray200}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 14">

                <VerticalStackLayout
                    Spacing="14">

                    <Label
                        Text="ОСНОВНЫЕ ДАННЫЕ"
                        FontSize="11"
                        FontAttributes="Bold"
                        TextColor="{StaticResource Gray500}" />

                    <Entry
                        Placeholder="Название"
                        Text="{Binding Title}" />

                    <Entry
                        Placeholder="Логин"
                        Text="{Binding Username}" />

                    <Entry
                        Placeholder="Веб-сайт"
                        Text="{Binding Website}" />

                </VerticalStackLayout>

            </Border>


            <!-- Пароль -->
            <Border
                Padding="18"
                Stroke="{StaticResource Gray200}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 14">

                <VerticalStackLayout
                    Spacing="12">

                    <Label
                        Text="ПАРОЛЬ"
                        FontSize="11"
                        FontAttributes="Bold"
                        TextColor="{StaticResource Gray500}" />

                    <Entry
                        Placeholder="Введите пароль"
                        Text="{Binding Password}"
                        IsPassword="True" />

                    <Grid
                        ColumnDefinitions="*, Auto"
                        ColumnSpacing="12"
                        VerticalOptions="Center">

                        <Label
                            Text="{Binding PasswordLength, StringFormat='Длина: {0:F0}'}"
                            VerticalOptions="Center"
                            FontSize="14"
                            TextColor="{StaticResource Gray500}" />

                        <Stepper
                            Grid.Column="1"
                            Minimum="8"
                            Maximum="32"
                            Increment="1"
                            Value="{Binding PasswordLength}" />

                    </Grid>

                    <Label
                        Text="ТИПЫ СИМВОЛОВ"
                        FontSize="11"
                        FontAttributes="Bold"
                        TextColor="{StaticResource Gray500}"
                        Margin="0,6,0,0" />

                    <VerticalStackLayout
                        Spacing="4">

                        <HorizontalStackLayout
                            Spacing="10">

                            <CheckBox
                                IsChecked="{Binding UseLowercase}" />

                            <Label
                                Text="Строчные буквы (a-z)"
                                VerticalOptions="Center" />

                        </HorizontalStackLayout>

                        <HorizontalStackLayout
                            Spacing="10">

                            <CheckBox
                                IsChecked="{Binding UseUppercase}" />

                            <Label
                                Text="Заглавные буквы (A-Z)"
                                VerticalOptions="Center" />

                        </HorizontalStackLayout>

                        <HorizontalStackLayout
                            Spacing="10">

                            <CheckBox
                                IsChecked="{Binding UseDigits}" />

                            <Label
                                Text="Цифры (0-9)"
                                VerticalOptions="Center" />

                        </HorizontalStackLayout>

                        <HorizontalStackLayout
                            Spacing="10">

                            <CheckBox
                                IsChecked="{Binding UseSpecial}" />

                            <Label
                                Text="Специальные символы (!@#$...)"
                                VerticalOptions="Center" />

                        </HorizontalStackLayout>

                    </VerticalStackLayout>

                    <Button
                        Text="Сгенерировать пароль"
                        Command="{Binding GeneratePasswordCommand}"
                        HeightRequest="46" />

                </VerticalStackLayout>

            </Border>


            <!-- Заметки -->
            <Border
                Padding="18"
                Stroke="{StaticResource Gray200}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 14">

                <VerticalStackLayout
                    Spacing="8">

                    <Label
                        Text="ЗАМЕТКИ"
                        FontSize="11"
                        FontAttributes="Bold"
                        TextColor="{StaticResource Gray500}" />

                    <Editor
                        Placeholder="Дополнительная информация"
                        Text="{Binding Notes}"
                        AutoSize="TextChanges"
                        MinimumHeightRequest="120" />

                </VerticalStackLayout>

            </Border>


            <!-- Сохранение -->
            <Button
                Text="Сохранить изменения"
                Command="{Binding SaveCommand}"
                HeightRequest="52"
                FontSize="16"
                FontAttributes="Bold" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>