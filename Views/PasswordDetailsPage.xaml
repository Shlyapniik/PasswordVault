<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="PasswordVault.Views.PasswordDetailsPage"
    Title="Данные записи">

    <ScrollView>
        <VerticalStackLayout
            Padding="20"
            Spacing="18">

            <!-- Заголовок -->
            <VerticalStackLayout
                Spacing="4">

                <Label
                    Text="{Binding Title}"
                    FontSize="28"
                    FontAttributes="Bold" />

                <Label
                    Text="Данные сохранённой записи"
                    FontSize="14"
                    TextColor="{StaticResource Gray500}" />

            </VerticalStackLayout>


            <!-- Основные данные -->
            <Border
                Padding="18"
                Stroke="{StaticResource Gray200}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 14">

                <VerticalStackLayout
                    Spacing="16">

                    <!-- Логин -->
                    <VerticalStackLayout
                        Spacing="4">

                        <Label
                            Text="ЛОГИН"
                            FontSize="11"
                            FontAttributes="Bold"
                            TextColor="{StaticResource Gray500}" />

                        <Label
                            Text="{Binding Username}"
                            FontSize="16"
                            LineBreakMode="TailTruncation" />

                    </VerticalStackLayout>


                    <!-- Пароль -->
                    <VerticalStackLayout
                        Spacing="6">

                        <Label
                            Text="ПАРОЛЬ"
                            FontSize="11"
                            FontAttributes="Bold"
                            TextColor="{StaticResource Gray500}" />

                        <Entry
                            Text="{Binding Password}"
                            IsPassword="{Binding IsPasswordHidden}"
                            IsReadOnly="True"
                            FontSize="16"
                            BackgroundColor="Transparent"
                            Margin="0" />

                        <Grid
                            ColumnDefinitions="*, *"
                            ColumnSpacing="8">

                            <Button
                                Grid.Column="0"
                                Text="Показать"
                                Command="{Binding TogglePasswordVisibilityCommand}"
                                Padding="12,6"
                                FontSize="13" />

                            <Button
                                Grid.Column="1"
                                Text="Копировать"
                                Command="{Binding CopyPasswordCommand}"
                                Padding="12,6"
                                FontSize="13" />

                        </Grid>

                    </VerticalStackLayout>


                    <!-- Разделитель -->
                    <BoxView
                        HeightRequest="1"
                        Color="{StaticResource Gray200}" />


                    <!-- Веб-сайт -->
                    <VerticalStackLayout
                        Spacing="4">

                        <Label
                            Text="ВЕБ-САЙТ"
                            FontSize="11"
                            FontAttributes="Bold"
                            TextColor="{StaticResource Gray500}" />

                        <Label
                            Text="{Binding Website}"
                            FontSize="16"
                            LineBreakMode="TailTruncation" />

                    </VerticalStackLayout>

                </VerticalStackLayout>

            </Border>


            <!-- Заметки -->
            <Border
                Padding="18"
                Stroke="{StaticResource Gray200}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 14">

                <VerticalStackLayout
                    Spacing="8">

                    <Label
                        Text="ЗАМЕТКИ"
                        FontSize="11"
                        FontAttributes="Bold"
                        TextColor="{StaticResource Gray500}" />

                    <Label
                        Text="{Binding Notes}"
                        FontSize="15"
                        LineBreakMode="WordWrap" />

                </VerticalStackLayout>

            </Border>


            <!-- Действия -->
            <VerticalStackLayout
                Spacing="10">

                <Button
                    Text="Редактировать"
                    Command="{Binding EditCommand}"
                    HeightRequest="50"
                    FontSize="16"
                    FontAttributes="Bold" />

                <Button
                    Text="Удалить"
                    Command="{Binding DeleteCommand}"
                    HeightRequest="50"
                    FontSize="16" />

            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>