<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="PasswordVault.Views.PasswordDetailsPage"
    Title="Данные записи">

    <ScrollView>
        <VerticalStackLayout
            Padding="20"
            Spacing="15">

            <Label
                x:Name="TitleLabel"
                FontSize="28"
                FontAttributes="Bold" />

            <Label
                Text="Логин"
                FontAttributes="Bold" />

            <Entry
                x:Name="UsernameEntry"
                IsReadOnly="True" />

            <Label
                Text="Пароль"
                FontAttributes="Bold" />

            <Grid ColumnDefinitions="*, Auto">
                
                <Entry
                    x:Name="PasswordValueEntry"
                    Grid.Column="0"
                    IsPassword="True"
                    IsReadOnly="True" />

                <Button
                    x:Name="ShowPasswordButton"
                    Grid.Column="1"
                    Text="Показать"
                    Clicked="OnShowPasswordClicked" />
                
            </Grid>

            <Entry
                x:Name="PasswordEntry"
                IsPassword="True"
                IsReadOnly="True" />

            <Label
                Text="Веб-сайт"
                FontAttributes="Bold" />

            <Entry
                x:Name="WebsiteEntry"
                IsReadOnly="True" />

            <Label
                Text="Заметки"
                FontAttributes="Bold" />

            <Editor
                x:Name="NotesEditor"
                IsReadOnly="True"
                MinimumHeightRequest="120" />

            <Button
                Text="Редактировать"
                Clicked="OnEditClicked" />

            <Button
                Text="Удалить"
                Clicked="OnDeleteClicked" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>