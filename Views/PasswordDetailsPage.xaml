<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="PasswordVault.Views.PasswordDetailsPage"
    Title="Данные записи">

    <ScrollView>
        <VerticalStackLayout
            Padding="20"
            Spacing="15">

            <Label
                Text="{Binding Title}"
                FontSize="28"
                FontAttributes="Bold" />

            <Label
                Text="Логин"
                FontAttributes="Bold" />

            <Entry
                Text="{Binding Username}"
                IsReadOnly="True" />

            <Label
                Text="Пароль"
                FontAttributes="Bold" />

            <Grid 
                ColumnDefinitions="*, Auto, Auto"
                ColumnSpacing="5">

                <Entry
                    Text="{Binding Password}"
                    Grid.Column="0"
                    IsPassword="{Binding IsPasswordHidden}"
                    IsReadOnly="True" />

                <Button
                    Grid.Column="1"
                    Text="Показать"
                    Command="{Binding TogglePasswordVisibilityCommand}" />

                <Button
                    Grid.Column="2"
                    Text="Копировать"
                    Command="{Binding CopyPasswordCommand}" />

            </Grid>

            <Label
                Text="Веб-сайт"
                FontAttributes="Bold" />

            <Entry
                Text="{Binding Website}"
                IsReadOnly="True" />

            <Label
                Text="Заметки"
                FontAttributes="Bold" />

            <Editor
                Text="{Binding Notes}"
                IsReadOnly="True"
                MinimumHeightRequest="120" />

            <Button
                Text="Редактировать"
                Command="{Binding EditCommand}" />

            <Button
                Text="Удалить"
                Command="{Binding DeleteCommand}" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>