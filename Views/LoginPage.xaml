<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="PasswordVault.Views.LoginPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30"
            Spacing="20"
            VerticalOptions="Center">

            <Label
                Text="Password Vault"
                FontSize="32"
                HorizontalOptions="Center" />

            <Label
                Text="Введите мастер-пароль"
                FontSize="18"
                HorizontalOptions="Center" />

            <Entry
                x:Name="MasterPasswordEntry"
                Placeholder="Мастер-пароль"
                IsPassword="True" />

            <Button
                Text="Разблокировать"
                Clicked="OnUnlockClicked" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>